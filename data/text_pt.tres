"ult_dome_abs": "Suspensão Absoluta",
"ult_dome_abs_desc": "Uma cúpula grande acompanha você por 8 segundos. Dentro dela, os tiros inimigos param no ar, os inimigos ficam lentos, todo tiro seu põe um Selo e fere mais, e a Explosão custa metade.",
"talent_brasa_viva": "Brasa Viva",
"talent_brasa_viva_desc": "O Selo detonado deixa 3 segundos de queimadura de 4 por segundo no alvo e em quem está a 1,5 m.",
"talent_pavio_longo": "Pavio Longo",
"talent_pavio_longo_desc": "Os tiros queimam: 2 por segundo, e o terceiro tiro 5 por segundo. Não combina com Cadeia Curta.",
"talent_combustao": "Combustão",
"talent_combustao_desc": "A Explosão queima todos que atinge (4 por segundo) e o raio cresce 25%.",
"talent_inferno_runico": "Inferno Rúnico",
"talent_inferno_runico_desc": "A Explosão amplificada deixa 4 segundos de brasa no chão: 10 por segundo no raio da Explosão normal.",
"talent_eco_arcano": "Eco Arcano",
"talent_eco_arcano_desc": "Cada Selo detonado devolve 1 de Magia a mais.",
"talent_cadeia_curta": "Cadeia Curta",
"talent_cadeia_curta_desc": "O Selo vem um tiro mais cedo, mas o terceiro tiro bate 5 mais fraco. Não combina com Pavio Longo.",
"talent_selo_duplo": "Selo Duplo",
"talent_selo_duplo_desc": "Um inimigo guarda 2 Selos. A Explosão consome os dois: o bônus de Selo vira 40% maior, e rende o dobro de Magia e de Ressonância.",
"talent_ruptura": "Ruptura",
"talent_ruptura_desc": "O Selo detonado salta uma vez para o inimigo sem Selo mais próximo, num raio de 4 m, e dura 4 segundos.",
"talent_circulo_expandido": "Círculo Expandido",
"talent_circulo_expandido_desc": "O Círculo ganha 0,8 m de raio.",
"talent_prisao_sigilada": "Prisão Sigilada",
"talent_prisao_sigilada_desc": "Ao fechar o puxão, os inimigos comuns ficam presos no lugar por 0,6 segundo.",
"talent_suspensao_larga": "Suspensão Larga",
"talent_suspensao_larga_desc": "A Suspensão ganha 0,8 m de raio e dura 1 segundo a mais.",
"talent_contencao_perfeita": "Contenção Perfeita",
"talent_contencao_perfeita_desc": "O Círculo dura 2 segundos a mais e o Selo vem no primeiro tiro dentro dele.",
"talent_chama_que_marca": "Chama que Marca",
"talent_chama_que_marca_desc": "O terceiro tiro, o que põe o Selo, queima: 5 por segundo.",
"talent_brasa_gemea": "Brasa Gêmea",
"talent_brasa_gemea_desc": "A Explosão que detona 3 Selos ou mais solta uma segunda, com metade do dano, meio segundo depois.",
"talent_selo_no_chao": "Selo no Chão",
"talent_selo_no_chao_desc": "Ao fechar o puxão, o Círculo põe um Selo em todos os inimigos dentro.",
"talent_leitura_rapida": "Leitura Rápida",
"talent_leitura_rapida_desc": "A recarga do Círculo e da Suspensão cai 25%.",
"talent_brasa_que_prende": "Brasa que Prende",
"talent_brasa_que_prende_desc": "O Círculo queima ao fechar: 12 de dano e 4 por segundo em todos dentro.",
"talent_passo_de_brasa": "Passo de Brasa",
"talent_passo_de_brasa_desc": "O Passo solta um clarão de 12 de dano onde você estava e deixa brasa onde você chega.",
"talent_passo_longo": "Passo Longo",
"talent_passo_longo_desc": "O Passo vai 0,8 m mais longe.",
