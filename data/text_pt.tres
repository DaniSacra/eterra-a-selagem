"hero_gifts": "Ver os Dons",
"hero_passive": "Ímpeto da Emeth",
"hero_passive_desc": "Cada combo que termina devolve Magia e prepara o Ritmo de Batalha.",
"hero_passive_note": "Sempre ativo",
"talent_disciplina": "Disciplina",
"talent_disciplina_desc": "Esquiva: não corta a sequência; ela espera até 2 s pelo próximo golpe.",
"talent_cadencia": "Cadência",
"talent_cadencia_desc": "Ataque: cada golpe seguido acelera o próximo em 8%.",
"talent_maestria_marcial": "Maestria Marcial",
"talent_maestria_marcial_desc": "Ataque: a sequência passa de três para cinco golpes, sempre terminando no giro.",
"talent_apogeu": "Apogeu",
"talent_apogeu_desc": "Ataque: o último golpe causa 150% do dano que a sequência já causou àquele inimigo (no máximo 4 vezes o do próprio golpe).",
"talent_forca_concentrada": "Força Concentrada",
"talent_forca_concentrada_desc": "Golpes carregados (Esmagador e Lança): 40% a mais de dano.",
"talent_determinacao": "Determinação",
"talent_determinacao_desc": "Ataque: devolve o dobro de Magia.",
"talent_concentracao": "Concentração",
"talent_concentracao_desc": "Golpes carregados: carregam 30% mais rápido.",
"talent_forca_titanica": "Força Titânica",
"talent_forca_titanica_desc": "Golpes carregados: 3x de dano, gastam o dobro de Magia. A Magia máxima sobe de 30 para 40.",
"talent_ruptura": "Ruptura",
"talent_ruptura_desc": "Finalizadores e o Esmagador: gastam 50% mais da Quebra e da postura dos inimigos.",
"talent_imposicao": "Imposição",
"talent_imposicao_desc": "Em todo golpe, a Quebra dura 50% mais nos inimigos comuns.",
"talent_investida_implacavel": "Esquiva Implacável",
"talent_investida_implacavel_desc": "Esquiva: atravessa os inimigos e atordoa 2 s os comuns; elites e guardiões perdem postura.",
