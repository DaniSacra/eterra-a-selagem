"move_spark": "Centelha",
"move_combust": "Combustão",
"move_shard": "Estilhaço",
"move_frost": "Geada",
"move_arc": "Arco Voltaico",
"ult_converge": "Convergência Elemental",
"move_breath": "Sopro Glacial",
"move_winter": "Inverno Eterno",
"ult_storm": "Tempestade Celestial",
"ult_storm_desc": "Um raio de 90 de dano que salta entre até 6 inimigos, até 5 metros de um para o outro, e os deixa Eletrizados. Cada salto causa 10% menos. Contra um alvo só, golpeia 3 vezes.",
"tip_maga_rd": "A Maga mudou: toque o esquerdo para a Centelha em leque e o direito para o Sopro Glacial. Segure e solte para a Combustão e o Inverno Eterno: quanto mais segurar, maior e mais caro.",
"ult_converge_desc": "Uma área no alvo por 4,5 segundos: primeiro gelo, depois fogo, depois eletricidade. As reações acontecem em cada fase.",
"talent_faisca_persistente": "Faísca Persistente",
"talent_faisca_persistente_desc": "Centelha: a Queimadura dura 2 s a mais e causa 25% a mais de dano.",
"talent_orvalho_gelido": "Orvalho Gélido",
"talent_orvalho_gelido_desc": "Estilhaço: o Frio congela com um acerto a menos e a lentidão aumenta 15%.",
"talent_reacao_amplificada": "Reação Amplificada",
"talent_reacao_amplificada_desc": "Reações: Choque Térmico e Sobrecarga causam 50% a mais de dano.",
"talent_fissao_termica": "Fissão Térmica",
"talent_fissao_termica_desc": "Reações: Choque Térmico e Sobrecarga também ferem quem está a 2 m, com metade do dano.",
"talent_geada_demorada": "Geada Demorada",
"talent_geada_demorada_desc": "Geada: dura 2 s a mais e o raio cresce 0,5 m.",
"talent_chao_ardente": "Chão Ardente",
"talent_chao_ardente_desc": "Combustão: deixa o chão em chamas por 3 s, incendiando quem pisa.",
"talent_suspensao_ampla": "Suspensão Ampla",
"talent_suspensao_ampla_desc": "Suspensão: o raio cresce 0,6 m e dura 1 s a mais.",
"talent_campo_elementar": "Campo Elementar",
"talent_campo_elementar_desc": "Suspensão: dentro dela, seus tiros e áreas causam 30% a mais de dano.",
"talent_eco_eletrico": "Eco Elétrico",
"talent_eco_eletrico_desc": "Arco Voltaico: atinge mais 1 inimigo.",
"talent_fluxo_de_magia": "Fluxo de Magia",
"talent_fluxo_de_magia_desc": "Centelha: cada acerto dá 0,5 de Magia a mais, e o Estilhaço também.",
"talent_estilhaco_gemeo": "Estilhaço Gêmeo",
"talent_estilhaco_gemeo_desc": "Estilhaço: guarda 2 cargas e recarrega 25% mais rápido.",
"talent_tempestade_contida": "Tempestade Contida",
"talent_tempestade_contida_desc": "Arco Voltaico: salta em mais 2 inimigos, e a Convergência carrega 25% mais rápido.",
"word_react_thermal": "Choque Térmico",
"word_react_overload": "Sobrecarga",
"word_react_crystal": "Cristalização",
"hero_action_hold_attack_maga": "Combustão",
"hero_action_hold_special_maga": "Inverno Eterno",
"hero_skill_name_hold_special_maga": "Inverno Eterno",
"howto_light_attack_desc_maga": "Toque: a Centelha lança três chispas de fogo de uma vez, em leque, de graça; cada acerto incendeia. Segure e solte: a Combustão é uma bola de fogo que cresce com o tempo e explode onde acerta, de 15 a 25 de Magia cobrados ao soltar. Esquiva cancela sem custo.",
"howto_heavy_attack_desc_maga": "Toque: o Sopro Glacial é um cone de gelo de 5 metros, de graça: dano, Frio e 30% de lentidão. Segure e solte: o Inverno Eterno congela o chão onde você mira por 5 segundos, e o raio cresce com o tempo, de 10 a 30 de Magia cobrados ao soltar.",
"howto_ultimate_desc_maga": "A Tempestade Celestial: um raio que salta entre até 6 inimigos e os deixa eletrizados. Carrega com a Magia gasta e com o dano que você causa e sofre; quando o losango enche, aperte para soltar.",
"howto_dodge_desc_maga": "O Passo Etéreo: um passo curto e protegido, com duas cargas. Só esquiva: não ataca.",
"howto_regen_maga": "A Magia volta sozinha, 3 por segundo, até andando. Os toques são de graça e preparam; os golpes segurados gastam Magia e resolvem. Fogo e depois gelo faz Choque Térmico. As reações enchem o Golpe Supremo.",
"lesson_spark_maga": "Aperte {attack}: a Centelha lança três chispas de fogo de uma vez, de graça",
"lesson_breath_maga": "Aperte {power}: o Sopro Glacial é um cone de gelo, de graça. Fogo e depois gelo faz Choque Térmico",
"lesson_combust_maga": "Segure {attack} e solte: a Combustão é uma bola de fogo que cresce enquanto você segura e gasta Magia ao soltar",
"lesson_winter_maga": "Segure {special} e solte: o Inverno Eterno congela uma área do chão, e ela cresce enquanto você segura",
"tip_hold_maga": "Segure {attack} para a Combustão ou {special} para o Inverno Eterno, e solte para lançar. Os dois gastam Magia.",
"tip_maga_v1": "A Maga mudou: o Arco Voltaico agora é segurar o esquerdo, a Geada é segurar o direito, e a Magia volta sozinha.",
"tip_regen": "A Magia volta sozinha, 3 por segundo. Cada reação devolve mais 3.",
"gloss_react_thermal": "Choque Térmico: Fogo e Gelo no mesmo inimigo, 35 de dano.",
"gloss_react_overload": "Sobrecarga: Fogo e Eletricidade, 25 de dano em 1,8 m.",
"gloss_react_crystal": "Cristalização: Gelo e Eletricidade, congela os comuns por 0,8 s e abala a postura dos fortes.",
"talent_afinidade": "Afinidade",
"talent_afinidade_desc": "Queimadura, Frio e Eletrizado duram 50% mais.",
"talent_catalisador": "Catalisador",
"talent_catalisador_desc": "Reações: causam 30% a mais de dano.",
"talent_propagacao": "Propagação",
"talent_propagacao_desc": "O elemento do seu golpe passa ao inimigo mais perto, a até 3 m, uma vez por magia.",
"talent_trindade": "Trindade",
"talent_trindade_desc": "Uma reação deixa um resíduo por 3 s. Se o terceiro elemento chegar, as duas outras reações acontecem juntas.",
"talent_permanencia": "Permanência",
"talent_permanencia_desc": "Inverno Eterno e brasas: duram 30% mais.",
"talent_expansao": "Expansão",
"talent_expansao_desc": "Inverno Eterno e brasas: o raio cresce 25%.",
"talent_manifestacao": "Manifestação",
"talent_manifestacao_desc": "Choque Térmico e Sobrecarga deixam brasa no chão por 3 s, que incendeia quem pisa.",
"talent_confluencia": "Confluência",
"talent_confluencia_desc": "Quem está ao mesmo tempo no Inverno Eterno e numa brasa sofre um Choque Térmico a cada 2 s.",
"talent_fluxo_arcano": "Fluxo Arcano",
"talent_fluxo_arcano_desc": "A Magia volta 1 por segundo mais rápido.",
"talent_agilidade_arcana": "Agilidade Arcana",
"talent_agilidade_arcana_desc": "Combustão e Inverno Eterno: carregam 30% mais rápido.",
"talent_reciprocidade": "Reciprocidade",
